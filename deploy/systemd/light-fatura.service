[Unit]
Description=Light Fatura Go service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=light-fatura
Group=light-fatura
WorkingDirectory=/opt/light-fatura/current
EnvironmentFile=/etc/light-fatura/light-fatura.env
ExecStart=/opt/light-fatura/current/light-fatura
Restart=always
RestartSec=2s
TimeoutStopSec=20s
KillSignal=SIGTERM
LimitNOFILE=131072

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

StandardOutput=journal
StandardError=journal
SyslogIdentifier=light-fatura

[Install]
WantedBy=multi-user.target
